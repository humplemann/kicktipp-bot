# required environment variables
KICKTIPP_EMAIL=email@example.com
KICKTIPP_PASSWORD=Password123
KICKTIPP_NAME_OF_COMPETITION=competition-name

# optional environment variables
KICKTIPP_HOURS_UNTIL_GAME=8
KICKTIPP_RUN_EVERY_X_MINUTES=20
OVERWRITE_TIPS=false  # Optional: Overwrite already set tips (true/false, default: false)

# allow tty
PYTHONUNBUFFERED=1

# CHROMEDRIVER_PATH=/usr/bin/chromedriver # uncomment this if you run without docker and encounter problems with the driver

ZAPIER_URL=https://hooks.zapier.com/hooks/catch/12345678/abcdefgh/

NTFY_URL=https://ntfy.your-domain.com/kicktipp-bot
NTFY_USERNAME=your-username
NTFY_PASSWORD=your-password

WEBHOOK_URL=https://your-home-assistant-url.com/api/webhook/your-webhook-id

# Optional: Group all notifications into one webhook call at the end of each run (true/false, default: false)
GROUP_NOTIFICATIONS=false

SENTRY_DSN=https://token@org.ingest.de.sentry.io/project
SENTRY_ENVIRONMENT=localhost

# Timezone for the application
TZ=Europe/Berlin
KICKTIPP_TIP_STRATEGY=ev  # Optional: "ev" (expected points, default) or "legacy"
KICKTIPP_POINTS_SCHEME=2,3,4  # Optional: points for Tendenz,Tordifferenz,Ergebnis in your league
KICKTIPP_QUOTENPUNKTE=auto  # Optional: auto/true/false, read points per tendency in quote-rule leagues
KICKTIPP_DRAW_DIFFERENCE_BONUS=true  # Optional: false if a draw tip gets no Tordifferenz points
#KICKTIPP_GROUP_SIZE=20  # Optional: active tippers, to account for the bot's own tip
KICKTIPP_UNDERDOG_MARGIN=0.3  # Optional: how much more expected points an underdog tip needs (0 = pure EV)
